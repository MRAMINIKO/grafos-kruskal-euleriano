{
    "compilerOptions": {
        "target": "es2025",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strict": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noImplicitAny": true,
        "noEmit": true
    },
    "include": ["src"],
    "references": [{ "path": "./tsconfig.node.json" }]
}